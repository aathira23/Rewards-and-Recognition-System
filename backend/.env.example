# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/rewards_db

# Application Configuration
APP_NAME=Rewards & Recognition System
DEBUG=True

# CORS Configuration (comma-separated origins for production)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Optional: Refresh Token Configuration
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional: System Configuration
# SYSTEM_MONTHLY_BUDGET_CAP=100000

# ─────────────────────────────────────────────────────────────
# User Service Integration
# ─────────────────────────────────────────────────────────────
# Authentication is handled by the centralized User Service.
USER_SERVICE_BASE_URL=http://localhost:9102
GET_USER_DETAILS_URL=http://localhost:9102/python/api/v1/auth/token/get_user_details
GET_USERS_URL=http://localhost:9102/python/api/v1/users
GET_USER_BATCH_URL=http://localhost:9102/python/api/v1/users/batch
STYRIA_LOGIN_URL=http://localhost:9102/python/api/v1/auth/login

# Set to False ONLY if User Service uses a self-signed certificate (dev tunnels etc.)
# In production with a proper cert this should always be True (the default)
USER_SERVICE_VERIFY_SSL=True

# Long-lived service account token used by background jobs (celebrations, pending approvals).
# Obtain from the User Service admin.
# SYSTEM_TOKEN=

# ─────────────────────────────────────────────────────────────
# Email Sender Configuration
# ─────────────────────────────────────────────────────────────
SUPPORT_EMAIL=noreply@rnr.local
SENDER_NAME=Rewards & Recognition

# ─────────────────────────────────────────────────────────────
# Notification Service Integration (Styria)
# ─────────────────────────────────────────────────────────────
# Base URL of the Java/Spring Boot notification microservice.
NOTIFICATION_SERVICE_BASE_URL=http://localhost:9030
# Set True to also send Microsoft Teams DMs alongside emails.
# Requires the notification service to be configured with valid MS Graph creds.
TEAMS_NOTIFICATIONS_ENABLED=False
# Comma-separated email addresses for broadcast Teams recipients (e.g. HR alerts).
# TEAMS_RECIPIENTS=
# MS Teams team ID for channel-level messages (optional).
# TEAMS_TEAM_ID=
# Set False when the notification service uses a self-signed certificate (staging).
NOTIFICATION_SERVICE_VERIFY_SSL=False
