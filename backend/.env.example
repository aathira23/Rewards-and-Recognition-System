# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/rewards_db

# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
APP_NAME=Rewards & Recognition System
DEBUG=True

# CORS Configuration (comma-separated origins for production)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Optional: Refresh Token Configuration
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional: System Configuration
# SYSTEM_MONTHLY_BUDGET_CAP=100000

# ─────────────────────────────────────────────────────────────
# User Service Integration
# ─────────────────────────────────────────────────────────────
# AUTH_MODE controls how tokens are validated:
#   "local"        → decode local HS256 JWT + DB lookup (default, for dev)
#   "user_service" → validate via centralized User Service (production)
AUTH_MODE=local
USER_SERVICE_BASE_URL=http://localhost:9102
GET_USER_DETAILS_URL=http://localhost:9102/python/api/v1/auth/token/get_user_details

# ─────────────────────────────────────────────────────────────
# Email / SMTP Configuration
# ─────────────────────────────────────────────────────────────
# The app reads all SMTP_* keys from this file via app/core/config.py.
# Leave SMTP_USERNAME empty to skip authentication (local dev only).

# ── Option 1: Mailtrap (recommended for testing) ─────────────
# Sign up free at https://mailtrap.io → Inboxes → Demo inbox → SMTP Settings
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=<mailtrap_username>
# SMTP_PASSWORD=<mailtrap_password>
# SMTP_USE_TLS=False
# SMTP_FROM_EMAIL=noreply@rnr.local
# SMTP_FROM_NAME=Rewards & Recognition

# ── Option 2: Gmail (real sending, test account) ─────────────
# Create a dedicated Gmail, enable 2FA, generate an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=yourapp@gmail.com
# SMTP_PASSWORD=<16-char-app-password>
# SMTP_USE_TLS=True
# SMTP_FROM_EMAIL=yourapp@gmail.com
# SMTP_FROM_NAME=Rewards & Recognition

# ── Option 3: Local dev inbox (dev_smtp_inbox.py on :1025) ───
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=False
# SMTP_FROM_EMAIL=noreply@rnr.local
# SMTP_FROM_NAME=Rewards & Recognition
